# ==============================================================================
# Environment Configuration — NSE/BSE Pump-and-Dump Early Detector
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="NSE/BSE Pump-and-Dump Early Detector"
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_secure_random_key_in_production
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL / SQLite fallback)
# For local dev without Postgres running, defaults to SQLite: sqlite:///./market_surveillance.db
DATABASE_URL=postgresql://surveillance_user:surveillance_pass@localhost:5432/market_surveillance_db
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=./market_surveillance.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage & Model Paths
DATASET_DIR=./datasets
TRAINED_MODELS_DIR=./trained_models
MLRUNS_DIR=./mlruns

# Anomaly Detection & Scoring Thresholds
CONTAMINATION_RATE=0.05
LOOKBACK_WINDOW=20
Z_SCORE_VOLUME_THRESHOLD=3.0
PRICE_CHANGE_ALERT_THRESHOLD=10.0
VOLUME_SPIKE_RATIO_THRESHOLD=4.0
CONSECUTIVE_CIRCUITS_ALERT=3
HYBRID_HIGH_RISK_THRESHOLD=75.0
HYBRID_MEDIUM_RISK_THRESHOLD=50.0

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000
